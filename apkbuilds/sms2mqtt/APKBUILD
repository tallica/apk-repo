26520f5247b4048de890122e85abe6f8b9e43e20a9d99fa7e4eed576b40fc73320055a50d58d3e7025416ab557e831e1075f92500a95811a488674ea4c287469  sms2mqtt_0.7.9_linux_arm64.tar.gz
48a347cccb3de6e77a77b36bb3ac73c59f031a0b1667040b3538b969c6e632e67bbbacb35d3615b609e78c4f999a4c686c633e6b15053af3546b705b32c2c584  sms2mqtt.initd
