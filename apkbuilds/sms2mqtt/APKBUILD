# Maintainer: Michał Lipski <michal@tallica.pl>
#
# Repackages the official release binaries. Upstream publishes linux/amd64 and
# linux/arm64 builds; the armv7 asset is not currently published by this repo.
pkgname=sms2mqtt
pkgver=0.7.9
pkgrel=0
pkgdesc="Bridge between a Huawei USB modem and Home Assistant via MQTT"
url="https://github.com/tallica/sms2mqtt"
arch="x86_64 aarch64"
license="MIT"
depends="ca-certificates"
subpackages="$pkgname-openrc"
source="sms2mqtt_${pkgver}_linux_amd64.tar.gz::$url/releases/download/v$pkgver/sms2mqtt_${pkgver}_linux_amd64.tar.gz
	sms2mqtt_${pkgver}_linux_arm64.tar.gz::$url/releases/download/v$pkgver/sms2mqtt_${pkgver}_linux_arm64.tar.gz
	sms2mqtt.initd
	sms2mqtt.confd"
options="!check !strip" # prebuilt binary; upstream runs the tests before release
builddir="$srcdir"

package() {
	case "$CARCH" in
	x86_64) _asset="sms2mqtt_${pkgver}_linux_amd64.tar.gz" ;;
	aarch64) _asset="sms2mqtt_${pkgver}_linux_arm64.tar.gz" ;;
	*) die "unsupported architecture: $CARCH" ;;
	esac

	# abuild unpacks both release archives; extract the one for $CARCH
	# into its own directory so the binaries cannot overwrite each other.
	mkdir -p "$srcdir/$CARCH"
	tar -xzf "$srcdir/$_asset" -C "$srcdir/$CARCH"

	install -Dm755 "$srcdir/$CARCH/$pkgname" "$pkgdir"/usr/bin/"$pkgname"
	install -Dm644 "$srcdir/$CARCH/LICENSE" \
		"$pkgdir"/usr/share/licenses/"$pkgname"/LICENSE
	install -Dm755 "$srcdir/sms2mqtt.initd" \
		"$pkgdir"/etc/init.d/sms2mqtt
	install -Dm644 "$srcdir/sms2mqtt.confd" \
		"$pkgdir"/etc/conf.d/sms2mqtt
}

